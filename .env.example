# ---------------------------------------------------------------------------
# VERCEL / PRODUÇÃO
# ---------------------------------------------------------------------------
# Na Vercel, DEBUG=False, PostgreSQL, Blob privado e SMTP real são
# obrigatórios. A aplicação encerra a inicialização com uma mensagem clara se
# algum desses serviços estiver incompleto.

# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=gere-uma-chave-aleatoria-com-pelo-menos-50-caracteres
# DJANGO_ALLOWED_HOSTS=seu-projeto.vercel.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-projeto.vercel.app

# O Neon conectado ao projeto cria DATABASE_URL automaticamente.
# DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require
# DJANGO_DB_CONN_MAX_AGE=0

# O Vercel Blob privado conectado ao projeto precisa criar este token.
# BLOB_STORE_ID e BLOB_WEBHOOK_PUBLIC_KEY, sozinhos, não permitem uploads.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# SMTP real. O remetente precisa estar validado no provedor escolhido.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Para a conta Google Workspace da Coordenação, confirme com a UFAC se o
# acesso SMTP e a senha de aplicativo estão autorizados.
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=sistemas.ccet@ufac.br
# DJANGO_EMAIL_HOST_PASSWORD=senha-de-aplicativo-fornecida-pela-ufac
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_USE_SSL=False
# DJANGO_EMAIL_TIMEOUT=15
# DJANGO_DEFAULT_FROM_EMAIL=SGTCC <sistemas.ccet@ufac.br>

# HTTPS e cookies seguros.
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_TRUST_PROXY_SSL_HEADER=True
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_SECURE_HSTS_PRELOAD=False

