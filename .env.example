# DJANGO_DB_SSLMODE=require

# E-MAIL LOCAL: mensagens exibidas no terminal
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=SGTCC <nao-responda@ufac.br>

# PRODUÇÃO: exemplo de SMTP
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.exemplo.br
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=usuario-smtp
# DJANGO_EMAIL_HOST_PASSWORD=senha-smtp
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_USE_SSL=False

# SEGURANÇA DE PRODUÇÃO
# Use somente depois de confirmar HTTPS e o proxy da hospedagem.
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# LIMITE DE TENTATIVAS
# Os valores padrão já são adequados para desenvolvimento e para o primeiro
# deploy. Altere somente se houver uma necessidade operacional comprovada.
SGTCC_RATE_LIMIT_ENABLED=True
SGTCC_RATE_LIMIT_LOGIN_ATTEMPTS=8
SGTCC_RATE_LIMIT_LOGIN_WINDOW=900
SGTCC_RATE_LIMIT_EMAIL_ATTEMPTS=5
SGTCC_RATE_LIMIT_EMAIL_WINDOW=3600
SGTCC_RATE_LIMIT_IP_ATTEMPTS=40
SGTCC_RATE_LIMIT_IP_WINDOW=900
SGTCC_RATE_LIMIT_RETENTION_DAYS=7

# Só ative atrás de um proxy confiável que sobrescreva X-Forwarded-For.
SGTCC_TRUST_PROXY_CLIENT_IP=False

# LOGS ENVIADOS PARA O CONSOLE DO SERVIDOR
DJANGO_LOG_LEVEL=WARNING
SGTCC_LOG_LEVEL=INFO
