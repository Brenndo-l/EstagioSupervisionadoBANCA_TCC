# DESENVOLVIMENTO
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# E-MAIL LOCAL: mensagens exibidas no terminal
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=SGTCC <nao-responda@ufac.br>

# PRODUÇÃO: exemplo de SMTP
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
