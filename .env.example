# DESENVOLVIMENTO
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# BANCO LOCAL (padrão)
DJANGO_DB_ENGINE=sqlite
# DJANGO_DB_NAME=C:\caminho\para\db.sqlite3

# POSTGRESQL PARA PRODUÇÃO
# DJANGO_DB_ENGINE=postgresql
